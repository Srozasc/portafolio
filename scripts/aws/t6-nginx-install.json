{
  "commands": [
    "set +e",
    "echo '=== [1/8] Install nginx ==='",
    "dnf install -y nginx >/dev/null 2>&1",
    "nginx -v 2>&1",
    "echo ''",
    "echo '=== [2/8] Setup cert dir + copy LE cert from /tmp/le-cert ==='",
    "mkdir -p /etc/nginx/ssl",
    "cp /tmp/le-cert/fullchain.pem /etc/nginx/ssl/fullchain.pem",
    "cp /tmp/le-cert/key.pem /etc/nginx/ssl/key.pem",
    "chmod 644 /etc/nginx/ssl/fullchain.pem",
    "chmod 600 /etc/nginx/ssl/key.pem",
    "ls -la /etc/nginx/ssl/",
    "echo ''",
    "echo '=== [3/8] Write nginx vhost config ==='",
    "cat > /etc/nginx/conf.d/portafolio-api.conf <<'NGINX'",
    "server {",
    "    listen 443 ssl http2;",
    "    server_name api.portafolio.srozas.men;",
    "    ssl_certificate     /etc/nginx/ssl/fullchain.pem;",
    "    ssl_certificate_key /etc/nginx/ssl/key.pem;",
    "    ssl_protocols TLSv1.2 TLSv1.3;",
    "    ssl_ciphers HIGH:!aNULL:!MD5;",
    "    access_log /var/log/nginx/portafolio-api.access.log;",
    "    error_log  /var/log/nginx/portafolio-api.error.log;",
    "    location / {",
    "        proxy_pass http://127.0.0.1:8000;",
    "        proxy_set_header Host              $host;",
    "        proxy_set_header X-Real-IP         $remote_addr;",
    "        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;",
    "        proxy_set_header X-Forwarded-Proto $scheme;",
    "    }",
    "}",
    "NGINX",
    "cat /etc/nginx/conf.d/portafolio-api.conf",
    "echo ''",
    "echo '=== [4/8] Remove default nginx welcome site (port 80) ==='",
    "if [ -f /etc/nginx/nginx.conf ]; then",
    "    sed -i 's|^    listen       80 default_server;|#    listen       80 default_server;|' /etc/nginx/nginx.conf",
    "    sed -i 's|listen \\[::\\]:80 default_server;|# listen [::]:80 default_server;|' /etc/nginx/nginx.conf",
    "fi",
    "rm -f /etc/nginx/default.d/*.conf 2>/dev/null",
    "echo '  default welcome disabled'",
    "echo ''",
    "echo '=== [5/8] Test nginx config ==='",
    "nginx -t 2>&1",
    "echo ''",
    "echo '=== [6/8] Start nginx ==='",
    "systemctl enable nginx",
    "systemctl restart nginx",
    "sleep 2",
    "systemctl is-active nginx",
    "echo ''",
    "echo '=== [7/8] Verify backend still running on 127.0.0.1:8000 ==='",
    "curl -sS -m 5 http://127.0.0.1:8000/api/health 2>&1 | head -c 300",
    "echo ''",
    "echo ''",
    "echo '=== [8/8] Stop cloudflared (no longer needed) ==='",
    "systemctl stop cloudflared",
    "systemctl disable cloudflared",
    "systemctl is-active cloudflared 2>&1",
    "echo ''",
    "echo '=== Local curl through nginx (127.0.0.1:443) ==='",
    "curl -sS -m 10 -k https://127.0.0.1/api/health 2>&1 | head -c 300"
  ]
}