---
import '../styles/global.css';
import es from '../i18n/es.json';
import en from '../i18n/en.json';
import { ViewTransitions } from 'astro:transitions';
import Chatbot from '../components/Chatbot';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portafolio profesional navegable por chatbot con RAG.' } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as 'es' | 'en';
const t = locale === 'en' ? en : es;

// Locale-aware URL helpers. ES has no prefix (`/proyectos/`), EN uses
// `/en/proyectos/`. This matches the `prefixDefaultLocale: false` config.
const homePath = locale === 'en' ? '/en/' : '/';
const projectsPath = locale === 'en' ? '/en/proyectos/' : '/proyectos/';
const aboutPath = locale === 'en' ? '/en/sobre-mi/' : '/sobre-mi/';

// Lang switcher: navigate to the same page in the other locale by
// swapping the leading /es/ or /en/ prefix in the current pathname.
const pathname = Astro.url.pathname;
const stripped = pathname.replace(/^\/(es|en)/, '') || '/';
const otherLocale = locale === 'es' ? 'en' : 'es';
const otherLocalePath = `/${otherLocale}${stripped}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <header>
      <nav class="container">
        <a href={homePath} class="brand">{t.site.title}</a>
        <ul class="nav-links">
          <li><a href={homePath}>{t.nav.home}</a></li>
          <li><a href={projectsPath}>{t.nav.projects}</a></li>
          <li><a href={aboutPath}>{t.nav.about}</a></li>
          <li class="lang-switcher">
            <a href={otherLocalePath} hreflang={otherLocale} aria-label="Español" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
            <span>/</span>
            <a href={otherLocalePath} hreflang={otherLocale} aria-label="English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>&copy; 2026 Sebastián Rozas</p>
      </div>
    </footer>
    {/*
      Floating navigation assistant. The `transition:persist` directive is
      the magic that keeps the React island mounted across Astro View
      Transitions navigations — its DOM nodes and React state survive
      page-to-page transitions so the open/closed state, message history,
      and current project context follow the visitor everywhere.
    */}
    <Chatbot
      client:load
      transition:persist
      locale={locale}
      strings={{
        inputPlaceholder: t.home.chat.input_placeholder,
        send: t.home.chat.send,
        thinking: t.home.chat.thinking,
        errorTitle: t.home.chat.error_title,
        errorRetry: t.home.chat.error_retry,
        cardView: t.home.chat.card_view,
        emptyMessage: t.home.chat.empty_message,
        assistantTitle: t.home.chat.assistant_title,
        openChatAria: t.home.chat.open_chat,
        closeChatAria: t.home.chat.close_chat,
      }}
    />
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }
  .brand {
    font-weight: 600;
    color: var(--fg);
  }
  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .lang-switcher {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    color: var(--fg-muted);
  }
  .lang-switcher a[aria-current='true'] {
    color: var(--fg);
    font-weight: 600;
  }
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding-block: 2rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }
</style>
