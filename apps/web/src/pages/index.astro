---
import Base from '../layouts/Base.astro';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

const locale = Astro.currentLocale ?? 'es';
const t = locale === 'en' ? en : es;
---

<Base title={t.site.title} description={t.site.tagline}>
  <section class="container hero">
    <h1>{t.site.title}</h1>
    <p class="tagline">{t.site.tagline}</p>
    <p>{t.home.intro}</p>
    <p class="hint">{t.home.chat_hint}</p>
    <p class="ctas">
      <a href="#chat" class="cta primary">{t.home.open_chat}</a>
      <a href="/proyectos/" class="cta secondary">{t.home.view_projects}</a>
    </p>
    <p class="phase-note">
      <em>Phase 0 scaffold — chat and project pages coming in Phase 4-5.</em>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: 4rem;
    text-align: center;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
  }
  .tagline {
    color: var(--fg-muted);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  .hint {
    margin: 2rem auto;
    max-width: 36rem;
  }
  .ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .cta {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    border-radius: 0.375rem;
    font-weight: 500;
  }
  .cta.primary {
    background: var(--accent);
    color: white;
  }
  .cta.primary:hover {
    background: #1d4ed8;
    text-decoration: none;
  }
  .cta.secondary {
    border: 1px solid var(--border);
    color: var(--fg);
  }
  .cta.secondary:hover {
    background: #f9fafb;
    text-decoration: none;
  }
  .phase-note {
    margin-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }
</style>
