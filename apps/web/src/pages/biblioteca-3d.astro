---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Biblioteca3DStandalone from '../components/Biblioteca3D/Biblioteca3DStandalone.astro';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

/**
 * /biblioteca-3d — Spanish entry point for the 3D library scene.
 *
 * `projectsForLibrary` is the wide projection required by
 * `components/Biblioteca3D/types.ts` (`ProjectEntry`); the standalone
 * component serializes it into a JSON tag that `main.ts` feeds to
 * `buildCatalog()`. Built once at static-generation time — no runtime
 * fetches and no persistent client state on this route (S3, S7, S8, S9).
 */
const locale = (Astro.currentLocale ?? 'es') as 'es' | 'en';
const t = locale === 'en' ? en : es;

const allProjects = await getCollection('projects');
const projectsForLibrary = allProjects.map((p) => ({
  slug: p.data.slug,
  title_es: p.data.title_es,
  title_en: p.data.title_en,
  summary_es: p.data.summary_es,
  summary_en: p.data.summary_en,
  year: p.data.year,
  role_es: p.data.role_es,
  role_en: p.data.role_en,
  tags: p.data.tags,
  stack_es: p.data.stack_es,
  stack_en: p.data.stack_en,
  impact_es: p.data.impact_es ?? null,
  impact_en: p.data.impact_en ?? null,
  client: p.data.client ?? null,
  // ProjectEntry.links declares repo/demo/case_study as required-but-nullable
  // while the content schema makes them optional; normalize so the projection
  // satisfies the component prop type.
  links: {
    repo: p.data.links?.repo ?? null,
    demo: p.data.links?.demo ?? null,
    case_study: p.data.links?.case_study ?? null,
  },
}));

const projectsPath = '/proyectos/index.html';
const proyectosEmptyText = t.proyectos.empty;
const proyectosBackLabel = t.proyectos.detail.back;
---

<Base title={`${t.biblioteca3d.title} — ${t.site.title}`} description={t.biblioteca3d.subtitle}>
  <section class="container biblioteca3d-page">
    <header class="biblioteca3d-header">
      <h1>{t.biblioteca3d.title}</h1>
      <p class="biblioteca3d-subtitle">{t.biblioteca3d.subtitle}</p>
    </header>

    {projectsForLibrary.length === 0 ? (
      <p class="biblioteca3d-empty">
        {proyectosEmptyText}{' '}
        <a href={projectsPath}>{proyectosBackLabel}</a>
      </p>
    ) : (
      <Biblioteca3DStandalone projects={projectsForLibrary} />
    )}

    <p class="biblioteca3d-back">
      <a href={projectsPath}>← {proyectosBackLabel}</a>
    </p>
  </section>
</Base>

<style>
  .biblioteca3d-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .biblioteca3d-header {
    text-align: center;
  }
  .biblioteca3d-header h1 {
    margin: 0 0 0.5rem;
    font-size: 1.875rem;
  }
  .biblioteca3d-subtitle {
    margin: 0;
    color: var(--fg-muted);
    font-size: 1rem;
  }
  .biblioteca3d-empty {
    text-align: center;
    color: var(--fg-muted);
    padding-block: 2rem;
  }
  .biblioteca3d-back {
    margin: 0;
    text-align: center;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  /*
   * FAB visual handling on this route.
   *
   * The Chatbot FAB is mounted globally by Base.astro
   * (`<Chatbot client:load transition:persist>`) with bottom: 1.5rem /
   * right: 1.5rem positioning baked into Chatbot.css. That positioning
   * places the FAB above the 3D canvas with sufficient contrast — the
   * canvas has a `position: static` flow and z-index defaults, so the FAB
   * (z-index 9999) sits on top without overlap of interactive elements.
   *
   * No new reposition rule is added here: editing Chatbot.tsx is forbidden
   * and a `:global(.chatbot-fab)` rule would change positioning on every
   * page, not just this one. Leaving the FAB alone is the intended behavior.
   */
</style>
