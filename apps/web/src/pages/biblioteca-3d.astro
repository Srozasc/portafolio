---
import { getCollection } from 'astro:content';
import Biblioteca3DLayout from '../layouts/Biblioteca3DLayout.astro';
import Biblioteca3DStandalone from '../components/Biblioteca3D/Biblioteca3DStandalone.astro';
import es from '../i18n/es.json';
import en from '../i18n/en.json';

/**
 * /biblioteca-3d — Spanish entry point for the 3D library scene.
 *
 * Phase 5.5f (T19): switched from Base.astro to Biblioteca3DLayout so the
 * page renders fullscreen — no global navbar, no Chatbot FAB at the
 * right, no centred `<h1>` "Modo Biblioteca 3D" wrapper. The biblioteca
 * is a UI mode, not a section inside the portfolio (L20).
 *
 * `projectsForLibrary` is the wide projection required by
 * `components/Biblioteca3D/types.ts` (`ProjectEntry`); the standalone
 * component serializes it into a JSON tag that `main.ts` feeds to
 * `buildCatalog()`. Built once at static-generation time — no runtime
 * fetches and no persistent client state on this route (S3, S7, S8, S9).
 */
const locale = (Astro.currentLocale ?? 'es') as 'es' | 'en';
const t = locale === 'en' ? en : es;

const allProjects = await getCollection('projects');

/**
 * Phase 5.5g (L22): top-tags computation identical to the one in
 * `apps/web/src/layouts/Base.astro` for the standard-mode Chatbot, so
 * the bibliotecario's quick-filter chips stay aligned with the standard
 * Chatbot's chip row on vocabulary, ordering and counts.
 */
const topTags = (() => {
  const counts = new Map<string, number>();
  for (const project of allProjects) {
    for (const tag of project.data.tags) {
      counts.set(tag, (counts.get(tag) ?? 0) + 1);
    }
  }
  return Array.from(counts.entries())
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 10)
    .map(([tag, count]) => ({ tag, count }));
})();

const projectsForLibrary = allProjects.map((p) => ({
  slug: p.data.slug,
  title_es: p.data.title_es,
  title_en: p.data.title_en,
  summary_es: p.data.summary_es,
  summary_en: p.data.summary_en,
  year: p.data.year,
  role_es: p.data.role_es,
  role_en: p.data.role_en,
  tags: p.data.tags,
  stack_es: p.data.stack_es,
  stack_en: p.data.stack_en,
  impact_es: p.data.impact_es ?? null,
  impact_en: p.data.impact_en ?? null,
  client: p.data.client ?? null,
  // ProjectEntry.links declares repo/demo/case_study as required-but-nullable
  // while the content schema makes them optional; normalize so the projection
  // satisfies the component prop type.
  links: {
    repo: p.data.links?.repo ?? null,
    demo: p.data.links?.demo ?? null,
    case_study: p.data.links?.case_study ?? null,
  },
}));

const homePath = '/index.html';
const projectsPath = '/proyectos/index.html';
const proyectosEmptyText = t.proyectos.empty;
const proyectosBackLabel = t.proyectos.detail.back;
---

<Biblioteca3DLayout
  title={`${t.biblioteca3d.title} — ${t.site.title}`}
  description={t.biblioteca3d.subtitle}
>
  {projectsForLibrary.length === 0 ? (
    <p style="padding: 2rem; text-align: center;">
      {proyectosEmptyText}{' '}
      <a href={projectsPath}>{proyectosBackLabel}</a>
    </p>
  ) : (
    <Biblioteca3DStandalone projects={projectsForLibrary} indexPath={homePath} topTags={topTags} />
  )}
</Biblioteca3DLayout>
