---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Scene3D from '../../components/Scene3D';
import en from '../../i18n/en.json';

/**
 * /en/biblioteca-3d — EN mirror of the Biblioteca 3D page.
 *
 * Astro's `fallback: { en: 'es' }` would otherwise 30x /en/biblioteca-3d to
 * the ES page; we ship an explicit Astro page so the EN route renders
 * directly. The locale carried into <Scene3D/> comes from Astro.currentLocale
 * (which is 'en' on this URL even though the i18n JSON we load is unambiguous
 * — passing it explicitly keeps the contract identical to the ES mirror).
 */
const locale = (Astro.currentLocale ?? 'en') as 'es' | 'en';
const t = en;

const allProjects = await getCollection('projects');
const projectsForScene = allProjects.map((p) => ({
  slug: p.data.slug,
  title_es: p.data.title_es,
  title_en: p.data.title_en,
  year: p.data.year,
  tags: p.data.tags,
}));

const projectsPath = '/en/proyectos/index.html';
const proyectosEmptyText = t.proyectos.empty;
const proyectosBackLabel = t.proyectos.detail.back;
---

<Base title={`${t.biblioteca3d.title} — ${t.site.title}`} description={t.biblioteca3d.subtitle}>
  <section class="container biblioteca3d-page">
    <header class="biblioteca3d-header">
      <h1>{t.biblioteca3d.title}</h1>
      <p class="biblioteca3d-subtitle">{t.biblioteca3d.subtitle}</p>
    </header>

    {projectsForScene.length === 0 ? (
      <p class="biblioteca3d-empty">
        {proyectosEmptyText}{' '}
        <a href={projectsPath}>{proyectosBackLabel}</a>
      </p>
    ) : (
      <Scene3D client:only="react" locale={locale} projects={projectsForScene} />
    )}

    <p class="biblioteca3d-back">
      <a href={projectsPath}>← {proyectosBackLabel}</a>
    </p>
  </section>
</Base>

<style>
  .biblioteca3d-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .biblioteca3d-header {
    text-align: center;
  }
  .biblioteca3d-header h1 {
    margin: 0 0 0.5rem;
    font-size: 1.875rem;
  }
  .biblioteca3d-subtitle {
    margin: 0;
    color: var(--fg-muted);
    font-size: 1rem;
  }
  .biblioteca3d-empty {
    text-align: center;
    color: var(--fg-muted);
    padding-block: 2rem;
  }
  .biblioteca3d-back {
    margin: 0;
    text-align: center;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
</style>
