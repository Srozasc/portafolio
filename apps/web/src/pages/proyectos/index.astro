---
import Base from '../../layouts/Base.astro';
import es from '../../i18n/es.json';
import en from '../../i18n/en.json';

const locale = Astro.currentLocale ?? 'es';
const t = locale === 'en' ? en : es;
---

<Base title={`${t.nav.projects} — ${t.site.title}`}>
  <section class="container">
    <h1>{t.nav.projects}</h1>
    <p class="phase-note">
      <em>Projects will appear here in Phase 1, once the .md content collections are wired.</em>
    </p>
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 1rem;
  }
  .phase-note {
    color: var(--fg-muted);
  }
</style>
