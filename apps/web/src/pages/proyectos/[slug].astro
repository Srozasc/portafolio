---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import es from '../../i18n/es.json';
import en from '../../i18n/en.json';

/**
 * Dynamic project detail route.
 *
 * Note: with `prefixDefaultLocale: false`, Astro doesn't auto-generate the
 * `/en/proyectos/<slug>/` file for dynamic routes — the i18n fallback
 * config renders those as redirect stubs to the ES equivalent. The page
 * itself uses `Astro.currentLocale` so if/when the EN files are generated
 * (e.g., via a future Astro upgrade or explicit getStaticPaths tweak), the
 * right language strings will be used.
 */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const locale = Astro.currentLocale ?? 'es';
const t = locale === 'en' ? en : es;
const isEs = locale === 'en' ? false : true;

const title = isEs ? project.data.title_es : project.data.title_en;
const role = isEs ? project.data.role_es : project.data.role_en;
const summary = isEs ? project.data.summary_es : project.data.summary_en;
const stack = isEs ? project.data.stack_es : project.data.stack_en;
const impact = isEs ? project.data.impact_es : project.data.impact_en;
const backLabel = t.proyectos.detail.back;
const listingHref = isEs ? '/proyectos/index.html' : '/en/proyectos/index.html';
---

<Base title={`${title} — ${t.site.title}`} description={summary}>
  <section class="container">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={listingHref}>← {backLabel}</a>
    </nav>

    <div class="project-detail-layout" data-slug={project.id}>
      <article class="project-main">
        <header class="project-main__header">
          <h1>{title}</h1>
          <p class="project-main__subtitle">
            <span class="project-main__year">{project.data.year}</span>
            <span aria-hidden="true"> · </span>
            <span>{role}</span>
          </p>
          {project.data.client && (
            <p class="project-main__client">{project.data.client}</p>
          )}
          <p class="project-main__lead">{summary}</p>
        </header>

        <div class="project-body prose">
          <Content />
        </div>

        {impact && impact.length > 0 && (
          <section class="project-impact" aria-labelledby="impact-heading">
            <h2 id="impact-heading">{t.proyectos.detail.impact}</h2>
            <ul class="impact-list">
              {impact.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <aside class="project-sidebar" aria-label="project metadata">
        <dl class="project-sidebar__list">
          <div class="project-sidebar__row">
            <dt>{t.proyectos.detail.year}</dt>
            <dd class="project-sidebar__year">{project.data.year}</dd>
          </div>
          <div class="project-sidebar__row">
            <dt>{t.proyectos.detail.role}</dt>
            <dd>{role}</dd>
          </div>
          <div class="project-sidebar__row">
            <dt>{t.proyectos.detail.stack}</dt>
            <dd>
              <ul class="tag-list">
                {stack.map((item) => (
                  <li class="tag-chip">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="project-sidebar__row">
            <dt>{t.proyectos.detail.tags}</dt>
            <dd>
              <ul class="tag-list">
                {project.data.tags.map((tag) => (
                  <li class="tag-chip">{tag}</li>
                ))}
              </ul>
            </dd>
          </div>
          {project.data.links && (
            <div class="project-sidebar__row">
              <dt>{t.proyectos.detail.links.label}</dt>
              <dd>
                <ul class="project-sidebar__links">
                  {project.data.links.repo && (
                    <li>
                      <a href={project.data.links.repo} target="_blank" rel="noopener noreferrer">
                        {t.proyectos.detail.links.repo}
                      </a>
                    </li>
                  )}
                  {project.data.links.demo && (
                    <li>
                      <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer">
                        {t.proyectos.detail.links.demo}
                      </a>
                    </li>
                  )}
                  {project.data.links.case_study && (
                    <li>
                      <a href={project.data.links.case_study}>
                        {t.proyectos.detail.links.case_study}
                      </a>
                    </li>
                  )}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style>
  .project-detail-layout {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 960px) {
    .project-detail-layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      align-items: start;
    }
  }

  .project-main__header {
    margin-bottom: 2rem;
  }
  .project-main__header h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    line-height: 1.2;
  }
  .project-main__subtitle {
    margin: 0 0 0.5rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .project-main__client {
    margin: 0 0 1rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-style: italic;
  }
  .project-main__lead {
    margin: 0;
    font-size: 1.125rem;
    color: var(--fg);
  }

  /* Markdown body — keep simple, no Tailwind. */
  .prose :global(h2) {
    margin-top: 2rem;
    font-size: 1.375rem;
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.25rem;
  }
  .prose :global(code) {
    font-size: 0.9em;
  }

  .project-impact {
    margin-top: 2rem;
  }
  .project-impact h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  /* Sidebar */
  .project-sidebar {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    background: #fafafa;
  }
  @media (min-width: 960px) {
    .project-sidebar {
      position: sticky;
      top: 1.5rem;
    }
  }
  .project-sidebar__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project-sidebar__row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .project-sidebar__row dt {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    font-weight: 600;
  }
  .project-sidebar__row dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--fg);
  }
  .project-sidebar__year {
    font-size: 1.5rem !important;
    font-weight: 600;
    color: var(--accent) !important;
    font-variant-numeric: tabular-nums;
  }
  .project-sidebar__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* Stacked above main on mobile so the summary is visible first. */
  @media (max-width: 959px) {
    .project-sidebar {
      order: -1;
    }
  }
</style>
