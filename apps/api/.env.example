# HiRag15k — environment variables
#
# Copy this file to .env and fill in the values.
# All variables are optional; defaults are defined in backend/config.py.
#
# =============================================================================
# CHAT / LLM (MiniMax by default — OpenAI-compatible SDK)
# =============================================================================
# Primary endpoint for chat completions (OpenAI-compatible)
LLM_BASE_URL=https://api.MiniMax.io/v1
# Your MiniMax API key
LLM_API_KEY=<your_MiniMax_api_key>
# Chat model name (MiniMax-M2.7-highspeed or another model you have access to)
CHAT_MODEL=MiniMax-M2.7-highspeed

# =============================================================================
# EMBEDDINGS (OpenAI by default — switch to LOCAL with the commented values)
# =============================================================================
# Primary endpoint for embeddings (OpenAI-compatible)
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Your OpenAI API key (or "not-needed" for some local providers)
EMBEDDING_API_KEY=<your_openai_api_key>
# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# --- LOCAL embedding alternatives (commented out above; uncomment to use) ---
# LOCAL LM Studio / Ollama / vLLM example:
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=not-needed
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# =============================================================================
# PATHS
# =============================================================================
# Root directory for relative ingest file paths
DATA_DIR=./data
# ChromaDB on-disk persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# =============================================================================
# CHUNKING (do not tune without explicit request)
# =============================================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# =============================================================================
# RETRIEVAL (do not tune without explicit request)
# =============================================================================
TOP_K=4
SIMILARITY_THRESHOLD=0.1  # Calibrated for score = 1 - euclidean_distance proxy; see threshold-calibration.md

# =============================================================================
# INGEST (do not tune without explicit request)
# =============================================================================
# Maximum file size for ingest (5 MiB default)
MAX_INGEST_BYTES=5242880

# =============================================================================
# SERVER
# =============================================================================
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated CORS allowed origins (default: local dev origins)
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4321,http://127.0.0.1:4321


# =============================================================================
# GITHUB INGEST SCRIPT (scripts/ingest_repo.py)
# =============================================================================
# Token personal de GitHub para ingestar repos al portafolio.
# Sin token: rate limit 60 req/h. Con token: 5000 req/h.
# Crear en https://github.com/settings/tokens (classic, scope: repo:read).
GITHUB_TOKEN=
